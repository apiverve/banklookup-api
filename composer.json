        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "banklookup",
        "bank lookup api",
        "bank search api",
        "credit union lookup api",
        "fdic bank lookup",
        "bank data api"
    ],
    "homepage": "https://apiverve.com/marketplace/banklookup?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/banklookup",
        "source": "https://github.com/apiverve/banklookup-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Banklookup\\": "php/src/"
        }
    },
